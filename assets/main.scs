---
---

@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap");

// ---------- Theme settings (must come before importing minima) ----------
$base-font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
$base-font-size:   17px;
$base-line-height: 1.7;
$content-width:    760px;

$background-color: #0b1120;
$text-color:       #e2e8f0;
$brand-color:      #38bdf8;
$grey-color:       #94a3b8;
$grey-color-light: #1e293b;
$grey-color-dark:  #cbd5e1;

@import "minima";

$accent-2: #a78bfa;
$card:     #111a2e;
$border:   #1e293b;

body {
  background:
    radial-gradient(1200px 600px at 10% -10%, rgba(56, 189, 248, 0.12), transparent 60%),
    radial-gradient(900px 500px at 110% 10%, rgba(167, 139, 250, 0.12), transparent 60%),
    $background-color;
  background-attachment: fixed;
}

::selection { background: rgba(56, 189, 248, 0.35); }

h1, h2, h3 { color: #f8fafc; letter-spacing: -0.02em; font-weight: 800; }

a { color: $brand-color; transition: color 0.2s ease; }
a:hover { color: $accent-2; text-decoration: none; }

// ---------- Header ----------
.site-header {
  border-top: 0;
  border-bottom: 1px solid $border;
  background: rgba(11, 17, 32, 0.75);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  position: sticky;
  top: 0;
  z-index: 10;
}

.site-title,
.site-title:visited {
  font-weight: 800;
  letter-spacing: -0.02em;
  background: linear-gradient(90deg, $brand-color, $accent-2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.site-nav .page-link { color: $grey-color-dark; }
.site-nav .page-link:hover { color: $brand-color; }
@media screen and (max-width: 600px) {
  .site-nav { background-color: $card; border-color: $border; }
  .site-nav .menu-icon > svg path { fill: $grey-color-dark; }
}

// ---------- Hero ----------
.hero {
  padding: 56px 0 24px;
  text-align: left;
}

.hero .eyebrow {
  display: inline-block;
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  color: $brand-color;
  border: 1px solid rgba(56, 189, 248, 0.35);
  background: rgba(56, 189, 248, 0.08);
  padding: 4px 12px;
  border-radius: 999px;
  margin-bottom: 20px;
}

.hero h1 {
  font-size: 52px;
  line-height: 1.1;
  margin-bottom: 16px;
}

.hero h1 .grad {
  background: linear-gradient(90deg, $brand-color, $accent-2);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.hero p.lead {
  font-size: 20px;
  color: $grey-color;
  max-width: 600px;
}

.chips { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
.chips li {
  font-family: "JetBrains Mono", monospace;
  font-size: 14px;
  padding: 6px 14px;
  border-radius: 10px;
  background: $card;
  border: 1px solid $border;
  color: $grey-color-dark;
}

@media screen and (max-width: 600px) {
  .hero { padding-top: 32px; }
  .hero h1 { font-size: 36px; }
  .hero p.lead { font-size: 18px; }
}

// ---------- Post list as cards ----------
.post-list-heading {
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: $grey-color;
  margin-top: 40px;
}

.post-list > li {
  background: $card;
  border: 1px solid $border;
  border-radius: 16px;
  padding: 20px 24px;
  margin-bottom: 16px;
  transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
}

.post-list > li:hover {
  transform: translateY(-3px);
  border-color: rgba(56, 189, 248, 0.5);
  box-shadow: 0 10px 30px rgba(56, 189, 248, 0.08);
}

.post-list h3 { margin: 4px 0 0; }
.post-link { font-size: 22px; color: #f8fafc; }
.post-link:hover { color: $brand-color; }

.post-meta {
  font-family: "JetBrains Mono", monospace;
  font-size: 13px;
  color: $grey-color;
}

.rss-subscribe { color: $grey-color; font-size: 14px; }

// ---------- Single post ----------
.post-title { font-size: 44px; line-height: 1.15; }
@media screen and (max-width: 600px) { .post-title { font-size: 32px; } }

.post-content h2 { border-bottom: 1px solid $border; padding-bottom: 6px; }
.post-content ul li::marker { color: $brand-color; }

blockquote {
  color: $grey-color-dark;
  border-left: 4px solid $accent-2;
  background: $card;
  padding: 12px 18px;
  border-radius: 0 10px 10px 0;
  font-style: normal;
  letter-spacing: 0;
}

// Code blocks (minima defaults to a light background)
code, pre { font-family: "JetBrains Mono", monospace; }
code {
  background: $card;
  border: 1px solid $border;
  color: #f0abfc;
  padding: 2px 6px;
  border-radius: 6px;
}
pre, .highlight, .highlight pre, .highlight code {
  background: #0a0f1c !important;
  color: #e2e8f0;
  border-color: $border;
  border-radius: 12px;
}
pre > code { border: 0; padding: 0; color: inherit; background: transparent; }

// ---------- Footer ----------
.site-footer {
  border-top: 1px solid $border;
  color: $grey-color;
}
.site-footer .footer-heading { color: #f8fafc; }
.svg-icon { fill: $grey-color; }
